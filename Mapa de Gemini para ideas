import React, { useState, useRef } from 'react';
import { 
  MapPin, 
  Shield, 
  Flag, 
  Users, 
  Crosshair, 
  Trash2,
  MousePointer2,
  Info,
  Sparkles,
  Terminal,
  Loader2,
  X
} from 'lucide-react';

// Definición de las piezas disponibles (herramientas)
const TOOLS = [
  { id: 'pin', name: 'Marcador', icon: MapPin, color: 'text-red-400', bg: 'bg-red-500/20' },
  { id: 'base', name: 'Base / Defensa', icon: Shield, color: 'text-blue-400', bg: 'bg-blue-500/20' },
  { id: 'objective', name: 'Objetivo', icon: Flag, color: 'text-emerald-400', bg: 'bg-emerald-500/20' },
  { id: 'unit', name: 'Unidad', icon: Users, color: 'text-amber-400', bg: 'bg-amber-500/20' },
  { id: 'target', name: 'Punto Crítico', icon: Crosshair, color: 'text-purple-400', bg: 'bg-purple-500/20' },
];

export default function App() {
  const [pieces, setPieces] = useState([]);
  const [selectedTool, setSelectedTool] = useState(null);
  const [draggingId, setDraggingId] = useState(null);
  const mapRef = useRef(null);

  // Estados para la Inteligencia Artificial
  const [aiLoading, setAiLoading] = useState(false);
  const [aiResponse, setAiResponse] = useState("");
  const [isAiModalOpen, setIsAiModalOpen] = useState(false);

  // Maneja el clic en el mapa para colocar una nueva pieza
  const handleMapClick = (e) => {
    if (selectedTool && !draggingId && mapRef.current) {
      const rect = mapRef.current.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;

      const newPiece = {
        id: Date.now().toString(),
        toolId: selectedTool,
        x,
        y
      };
      
      setPieces([...pieces, newPiece]);
      setSelectedTool(null); // Deseleccionar después de colocar
    }
  };

  // Iniciar el arrastre de una pieza existente
  const handlePointerDown = (e, id) => {
    e.stopPropagation(); // Evitar que el clic se propague al mapa
    setDraggingId(id);
  };

  // Mover la pieza mientras se arrastra
  const handlePointerMove = (e) => {
    if (draggingId && mapRef.current) {
      const rect = mapRef.current.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;

      setPieces(pieces.map(p => 
        p.id === draggingId ? { ...p, x, y } : p
      ));
    }
  };

  // Soltar la pieza
  const handlePointerUp = () => {
    if (draggingId) {
      setDraggingId(null);
    }
  };

  // Eliminar una pieza con doble clic
  const handleDoubleClick = (e, id) => {
    e.stopPropagation();
    setPieces(pieces.filter(p => p.id !== id));
  };

  // Limpiar todo el tablero
  const clearBoard = () => {
    setPieces([]);
    setSelectedTool(null);
  };

  // --- INTEGRACIÓN DE GEMINI API ---
  const callGeminiAPI = async (prompt) => {
    const apiKey = ""; // La clave se provee en el entorno de ejecución
    const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`;
    const payload = {
      contents: [{ parts: [{ text: prompt }] }],
      systemInstruction: { parts: [{ text: "Eres una IA de comando táctico militar de élite analizando un mapa de la Región Metropolitana de Santiago de Chile." }] }
    };

    const delays = [1000, 2000, 4000, 8000, 16000];
    for (let attempt = 0; attempt <= 5; attempt++) {
      try {
        const response = await fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
        const data = await response.json();
        return data.candidates?.[0]?.content?.parts?.[0]?.text || "No se pudo decodificar la respuesta.";
      } catch (error) {
        if (attempt === 5) {
          return "Error de comunicación con el satélite de mando. Por favor, reintente más tarde.";
        }
        await new Promise(resolve => setTimeout(resolve, delays[attempt]));
      }
    }
  };

  const getStats = () => {
    return {
      bases: pieces.filter(p => p.toolId === 'base').length,
      units: pieces.filter(p => p.toolId === 'unit').length,
      targets: pieces.filter(p => p.toolId === 'target').length,
      objectives: pieces.filter(p => p.toolId === 'objective').length,
      pins: pieces.filter(p => p.toolId === 'pin').length,
    };
  };

  const handleGenerateSitRep = async () => {
    setAiLoading(true);
    setIsAiModalOpen(true);
    setAiResponse("Conectando con el satélite de Inteligencia Artificial...");
    
    const stats = getStats();
    const prompt = `Genera un "SITREP" (Informe de Situación) táctico basado en el siguiente despliegue en el mapa de Santiago:
    - Bases: ${stats.bases}
    - Unidades Desplegadas: ${stats.units}
    - Objetivos: ${stats.objectives}
    - Puntos Críticos: ${stats.targets}
    - Marcadores: ${stats.pins}
    
    Actúa como un comandante militar. El tono debe ser serio, estratégico y dramático. Usa jerga militar en español. Máximo 2 párrafos concisos.`;

    const response = await callGeminiAPI(prompt);
    setAiResponse(response);
    setAiLoading(false);
  };

  const handleGetAdvice = async () => {
    setAiLoading(true);
    setIsAiModalOpen(true);
    setAiResponse("Analizando vectores tácticos...");
    
    const stats = getStats();
    const prompt = `Actúa como mi consejero táctico jefe. Analiza este despliegue en Santiago:
    Bases: ${stats.bases}, Unidades: ${stats.units}, Objetivos: ${stats.objectives}, Puntos Críticos: ${stats.targets}.
    
    Considerando estos números, dame una recomendación estratégica de 2 párrafos sobre qué me falta, cuáles podrían ser mis vulnerabilidades, o qué tipo de pieza debería desplegar a continuación para asegurar la Región Metropolitana.`;

    const response = await callGeminiAPI(prompt);
    setAiResponse(response);
    setAiLoading(false);
  };
  // ---------------------------------

  return (
    <div className="flex h-screen w-full bg-slate-950 text-slate-200 font-sans overflow-hidden select-none">
      
      {/* Panel Lateral (Sidebar) */}
      <div className="w-72 bg-slate-900 border-r border-slate-800 flex flex-col z-10 shadow-xl">
        <div className="p-6 border-b border-slate-800">
          <h1 className="text-xl font-bold text-white tracking-wide">Comando Táctico</h1>
          <p className="text-sm text-slate-400 mt-1">Región Metropolitana</p>
        </div>

        <div className="p-4 flex-1 overflow-y-auto">
          <h2 className="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-4">
            Piezas de Ajedrez
          </h2>
          
          <div className="space-y-3">
            {TOOLS.map((tool) => {
              const Icon = tool.icon;
              const isSelected = selectedTool === tool.id;
              return (
                <button
                  key={tool.id}
                  onClick={() => setSelectedTool(isSelected ? null : tool.id)}
                  className={`w-full flex items-center space-x-3 p-3 rounded-lg border transition-all duration-200 ${
                    isSelected 
                      ? `border-${tool.color.split('-')[1]}-500 bg-slate-800 shadow-[0_0_15px_rgba(0,0,0,0.3)]` 
                      : 'border-transparent hover:bg-slate-800/50'
                  }`}
                >
                  <div className={`p-2 rounded-md ${tool.bg}`}>
                    <Icon className={`w-5 h-5 ${tool.color}`} />
                  </div>
                  <span className="font-medium text-sm">{tool.name}</span>
                </button>
              );
            })}
          </div>

          <div className="mt-8 p-4 bg-slate-800/50 rounded-lg border border-slate-700/50">
            <h3 className="text-xs font-semibold text-slate-400 flex items-center mb-2">
              <Info className="w-4 h-4 mr-1" /> Instrucciones
            </h3>
            <ul className="text-xs text-slate-500 space-y-2 list-disc pl-4">
              <li>Haz clic en una pieza arriba para seleccionarla.</li>
              <li>Haz clic en cualquier comuna del mapa para posicionarla.</li>
              <li>Arrastra las piezas para moverlas libremente.</li>
              <li>Haz <strong>doble clic</strong> en una pieza para eliminarla.</li>
            </ul>
          </div>

          {/* Panel de Inteligencia Artificial */}
          <div className="mt-6 p-4 bg-indigo-950/20 rounded-lg border border-indigo-500/30 shadow-[0_0_15px_rgba(99,102,241,0.1)]">
            <h3 className="text-xs font-semibold text-indigo-400 flex items-center mb-3">
              <Sparkles className="w-4 h-4 mr-1" /> Comando IA ✨
            </h3>
            <div className="space-y-2">
              <button 
                onClick={handleGenerateSitRep}
                disabled={aiLoading}
                className="w-full flex items-center justify-center space-x-2 p-2 bg-indigo-600/20 hover:bg-indigo-600/40 text-indigo-300 rounded border border-indigo-500/50 transition-colors text-xs font-medium disabled:opacity-50"
              >
                <Terminal className="w-3 h-3" />
                <span>Generar SITREP ✨</span>
              </button>
              <button 
                onClick={handleGetAdvice}
                disabled={aiLoading}
                className="w-full flex items-center justify-center space-x-2 p-2 bg-purple-600/20 hover:bg-purple-600/40 text-purple-300 rounded border border-purple-500/50 transition-colors text-xs font-medium disabled:opacity-50"
              >
                <Shield className="w-3 h-3" />
                <span>Análisis Táctico ✨</span>
              </button>
            </div>
          </div>
        </div>

        <div className="p-4 border-t border-slate-800">
          <button 
            onClick={clearBoard}
            className="w-full flex items-center justify-center space-x-2 p-3 bg-red-950/30 hover:bg-red-900/40 text-red-400 rounded-lg border border-red-900/50 transition-colors text-sm font-medium"
          >
            <Trash2 className="w-4 h-4" />
            <span>Limpiar Tablero</span>
          </button>
        </div>
      </div>

      {/* Área del Mapa Principal */}
      <div className="flex-1 relative bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-slate-900 to-slate-950 flex flex-col">
        
        {/* Barra superior de estado */}
        <div className="absolute top-0 left-0 w-full p-4 flex justify-between items-center pointer-events-none z-10">
          <div className="bg-slate-900/80 backdrop-blur border border-slate-700/50 px-4 py-2 rounded-full flex items-center shadow-lg">
            <span className="flex h-3 w-3 relative mr-3">
              <span className="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span className="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
            </span>
            <span className="text-sm font-medium text-slate-300">Sistema en Línea</span>
          </div>
          
          {selectedTool && (
            <div className="bg-indigo-950/80 backdrop-blur border border-indigo-500/30 px-6 py-2 rounded-full flex items-center shadow-lg text-indigo-200 text-sm animate-pulse">
              <MousePointer2 className="w-4 h-4 mr-2" />
              Haz clic en el mapa para posicionar la pieza
            </div>
          )}
        </div>

        {/* Contenedor interactivo del mapa */}
        <div 
          className="flex-1 flex items-center justify-center relative overflow-hidden"
          onPointerMove={handlePointerMove}
          onPointerUp={handlePointerUp}
          onPointerLeave={handlePointerUp}
        >
          {/* Fondo cuadriculado estratégico */}
          <div className="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:40px_40px] pointer-events-none"></div>
          
          {/* Contenedor del mapa y las piezas */}
          <div 
            ref={mapRef}
            onClick={handleMapClick}
            className={`relative w-[800px] h-[800px] flex items-center justify-center transition-transform ${selectedTool ? 'cursor-crosshair' : 'cursor-default'}`}
          >
            {/* El mapa JPG proporcionado. Se le aplica invert para que se vea blanco sobre fondo oscuro */}
            <img 
              src="Mapa Santiago Limpio.jpg" 
              alt="Mapa Limpio de Santiago" 
              className="w-full h-full object-contain pointer-events-none drop-shadow-[0_0_15px_rgba(255,255,255,0.1)]"
              style={{ filter: 'invert(1) brightness(0.8) opacity(0.8)' }}
            />

            {/* Renderizado de las piezas posicionadas */}
            {pieces.map((piece) => {
              const toolDef = TOOLS.find(t => t.id === piece.toolId);
              if (!toolDef) return null;
              
              const Icon = toolDef.icon;
              const isDragging = draggingId === piece.id;

              return (
                <div
                  key={piece.id}
                  className={`absolute transform -translate-x-1/2 -translate-y-1/2 flex items-center justify-center
                    ${isDragging ? 'scale-125 z-50 cursor-grabbing' : 'scale-100 z-40 cursor-grab hover:scale-110'} 
                    transition-transform duration-100 ease-out`}
                  style={{ left: piece.x, top: piece.y }}
                  onPointerDown={(e) => handlePointerDown(e, piece.id)}
                  onDoubleClick={(e) => handleDoubleClick(e, piece.id)}
                >
                  <div className={`relative ${toolDef.bg} p-2 rounded-full border border-slate-700/50 shadow-lg backdrop-blur-sm`}>
                    <Icon className={`w-8 h-8 ${toolDef.color} drop-shadow-[0_0_8px_currentColor]`} />
                    
                    {/* Indicador de arrastre */}
                    {isDragging && (
                      <div className="absolute inset-0 rounded-full border-2 border-white/50 animate-ping"></div>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </div>

      {/* Modal de Respuesta IA */}
      {isAiModalOpen && (
        <div className="absolute inset-0 z-50 flex items-center justify-center bg-slate-950/80 backdrop-blur-sm p-4">
          <div className="bg-slate-900 border border-indigo-500/50 rounded-xl shadow-[0_0_30px_rgba(99,102,241,0.2)] max-w-lg w-full overflow-hidden flex flex-col">
            <div className="bg-indigo-950/50 p-4 border-b border-indigo-500/30 flex justify-between items-center">
              <div className="flex items-center text-indigo-300 font-semibold">
                <Sparkles className="w-5 h-5 mr-2" />
                Transmisión de Comando IA
              </div>
              <button 
                onClick={() => setIsAiModalOpen(false)}
                className="text-slate-400 hover:text-white transition-colors"
              >
                <X className="w-5 h-5" />
              </button>
            </div>
            <div className="p-6 text-slate-300 text-sm leading-relaxed min-h-[150px] max-h-[60vh] overflow-y-auto">
              {aiLoading ? (
                <div className="flex flex-col items-center justify-center h-full space-y-4 text-indigo-400">
                  <Loader2 className="w-8 h-8 animate-spin" />
                  <p className="animate-pulse">{aiResponse}</p>
                </div>
              ) : (
                <div className="whitespace-pre-wrap font-mono text-emerald-400">
                  <span className="text-slate-500 select-none">{'> '}</span>
                  {aiResponse}
                </div>
              )}
            </div>
            {!aiLoading && (
              <div className="p-4 bg-slate-950 border-t border-slate-800 flex justify-end">
                <button 
                  onClick={() => setIsAiModalOpen(false)}
                  className="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-white rounded text-sm font-medium transition-colors"
                >
                  Cerrar Transmisión
                </button>
              </div>
            )}
          </div>
        </div>
      )}
    </div>
  );
}
